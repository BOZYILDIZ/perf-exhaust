// Schéma Prisma — PERF'EXHAUST
// Base : PostgreSQL (Neon / Vercel Postgres en production, instance locale en dev).
// Voir docs/MAINTENANCE.md § "Panel admin & base de données".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    String   @default("draft") // "draft" | "published"

  // Informations principales
  vehicule    String
  marque      String
  modele      String
  annee       String
  prestation  String
  categorie   String?
  tags        Json     @default("[]") // string[]
  sonoriteTag String
  filterTags  Json     @default("[]") // string[] — pilote les filtres de la galerie

  // Contenu
  description             String
  descriptionComplete     String
  objectifsClient         String  @default("")
  modificationsRealisees  String  @default("")
  materiaux               String  @default("")
  resultatSonore          String  @default("")
  dureeProjet             String?
  difficulte              String?
  ctaCustom               String?

  // Médias
  imagePrincipale String?
  imageAlt        String?
  galerie         Json    @default("[]") // { src, alt, type: "avant"|"apres"|"detail" }[]
  videoUrl        String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Divers
  featured  Boolean @default(false)
  date      String  @default("") // AAAA-MM-JJ (affichage + sitemap)
  sortOrder Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, sortOrder])
}

// Demandes de devis reçues via /rendez-vous — persistées en plus de l'email
// (mini-CRM atelier). Le formulaire continue de fonctionner même si l'écriture
// en base échoue (voir src/app/api/rendez-vous/route.ts).
model QuoteRequest {
  id  String @id @default(cuid())

  nom          String
  prenom       String
  email        String
  telephone    String

  // Adresse de facturation réelle du client — collectée depuis /rendez-vous
  // (obligatoire depuis le 2026-08-07, voir AppointmentForm.tsx). Nullable
  // pour les demandes créées avant cette date : ne jamais planter dessus,
  // toujours afficher "Adresse non renseignée". Utilisée comme billing_address
  // réelle lors de la création du client Pennylane (voir
  // src/lib/pennylane-v2/billing-address.ts) — jamais l'adresse de l'atelier.
  billingAddress    String?
  billingPostalCode String?
  billingCity       String?

  marque       String
  modele       String
  annee        String
  motorisation String?
  // Facultative partout (formulaire public, RDV manuel) — ajoutée 2026-08-10 pour la
  // recherche globale et l'identification atelier, jamais requise.
  licensePlate String?
  typeProjet   String
  sonorite     String
  rearDiffuser String  @default("je_ne_sais_pas") // "oui" | "non" | "je_ne_sais_pas"
  message      String

  // Photos du véhicule (upload public depuis /rendez-vous, voir
  // src/lib/vehicle-photo-slots.ts) — stockées sur Vercel Blob, jamais en
  // base : ce champ ne garde que les métadonnées ({ slot, url, name, size,
  // mimeType }[], max 5, un slot fixe par photo). Jamais transmises à
  // Pennylane (voir src/lib/pennylane/, src/lib/pennylane-v2/) : uniquement
  // consultables dans le panel admin et l'agenda.
  photos Json @default("[]")

  // Pipeline commercial atelier (2026-08-10) — remplace l'ancien jeu de valeurs
  // ("new"|"contacted"|"in_progress"|"completed"|"archived", conservé en
  // commentaire pour mémoire de la migration de données correspondante) :
  // "NOUVELLE" | "A_CONTACTER" | "DEVIS_EN_PREPARATION" | "DEVIS_ENVOYE"
  // | "EN_ATTENTE_CLIENT" | "ACCEPTE" | "REFUSE" | "RDV_PLANIFIE"
  // | "VEHICULE_ARRIVE" | "EN_INTERVENTION" | "TERMINE" | "RESTITUE" | "ARCHIVE"
  // Transitions "guidées" seulement (voir src/lib/quote-pipeline.ts) : l'UI
  // suggère le statut suivant logique, mais l'API n'interdit aucune valeur de
  // l'enum — un admin doit toujours pouvoir corriger une erreur de manip sans
  // être bloqué par une machine à états rigide.
  // VEHICULE_ARRIVE/EN_INTERVENTION/TERMINE/RESTITUE sont normalement pilotés
  // par les actions atelier sur le rendez-vous lié (Appointment.workshopStatus,
  // voir plus bas) — mis à jour ici en miroir à sens unique, jamais l'inverse.
  status String @default("NOUVELLE")
  notes  String @default("") // notes internes atelier, jamais exposées publiquement

  // Relances commerciales (devis envoyé, aucune évolution après X jours) — voir
  // src/lib/quote-followup.ts. followupStage : 0 = aucune relance envoyée,
  // 1 = relance 1 envoyée, 2 = relance 2 envoyée (jamais au-delà : pas de
  // 3e relance automatique prévue). Jamais renseigné pour un dossier qui
  // n'est plus au statut DEVIS_ENVOYE au moment de l'envoi (voir garde-fous).
  followupStage       Int       @default(0)
  lastFollowupSentAt  DateTime?

  // Demande d'avis Google — envoyée manuellement (ou par l'automation-runner
  // si activé) après RESTITUE + délai configurable (SiteSettings.reviewRequestDelayHours).
  // Jamais de vérification si l'avis a réellement été laissé (aucune API fiable).
  // NOTE (Phase C, 2026-08-10) : comme vehicleReadyNotifiedAt (déplacé sur
  // Appointment, voir plus bas), ce champ devra probablement suivre le même
  // chemin en Phase D pour fonctionner aussi sur un RDV manuel sans demande —
  // pas fait maintenant, hors périmètre de cette phase.
  reviewRequestSentAt DateTime?

  // Intégration Pennylane — voir src/lib/pennylane/. Deux modes cohabitent
  // (PENNYLANE_MODE, voir src/lib/pennylane/mode.ts) :
  //  - "api"    : brouillon créé automatiquement par POST /rendez-vous
  //               (nécessite un abonnement Pennylane avec accès API) ;
  //               statut reflété par pennylaneSyncStatus/*Error/*SyncedAt.
  //  - "manual" : plan gratuit Pennylane (pas d'API) — l'admin copie les
  //               informations depuis /admin/devis/[id] et crée le devis à
  //               la main dans Pennylane, puis renseigne pennylaneManualStatus
  //               + pennylaneQuoteNumber/Url manuellement.
  // Dans les deux cas, Pennylane reste la source unique pour les devis et
  // factures — le panel PERF'EXHAUST ne construit jamais de devis local.
  pennylaneCustomerId  String?
  pennylaneQuoteId     String?
  pennylaneQuoteNumber String?
  pennylaneQuoteUrl    String?
  pennylaneSyncStatus  String?   @default("not_configured") // mode "api" : "not_configured" | "pending" | "draft_created" | "failed"
  pennylaneSyncError   String?
  pennylaneSyncedAt    DateTime?
  pennylaneManualStatus String?  // mode "manual" : "a_creer" | "devis_cree" | "devis_envoye" | "devis_accepte" | "devis_refuse" | "facture_creee" | "paye"

  // Intégration Pennylane API v2 (src/lib/pennylane-v2/) — synchronisation
  // CLIENT automatique à la réception de chaque demande, indépendante des
  // champs "quote" ci-dessus (qui suivent la création manuelle/automatique
  // d'un DEVIS dans l'ancien flux). pennylaneCustomerId (ci-dessus) reste
  // l'identifiant client Pennylane commun aux deux intégrations — jamais
  // dupliqué, réutilisé tel quel. Statuts : "PENDING" | "SYNCED" | "FAILED"
  // | "AMBIGUOUS". Voir docs/MAINTENANCE.md § "Intégration Pennylane API v2".
  pennylaneCustomerSyncStatus  String?   @default("PENDING")
  pennylaneCustomerSyncError   String?
  pennylaneCustomerSyncedAt    DateTime? // dernière synchronisation RÉUSSIE
  pennylaneCustomerLastSyncAt  DateTime? // dernière TENTATIVE (réussie ou non)
  pennylaneCustomerType        String?   // "individual" | "company" une fois synchronisé
  // Candidats ambigus détectés lors de la recherche (statut AMBIGUOUS) —
  // snapshot au moment de la détection : [{ id, name, email, phone }].
  // L'admin choisit manuellement le bon client depuis le panel.
  pennylaneAmbiguousCandidates Json?

  // Cache des devis/factures Pennylane du client — évite un appel API à
  // chaque rendu de la fiche admin. Rafraîchi automatiquement si expiré à
  // l'ouverture, ou à la demande via le bouton "Actualiser" (voir
  // src/lib/pennylane-v2/cache.ts pour le délai d'expiration).
  pennylaneQuotesCache        Json?
  pennylaneInvoicesCache      Json?
  pennylaneFinancialsSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agenda atelier (2026-08) — une demande a au maximum un rendez-vous.
  // Suppression en cascade : un rendez-vous n'a de sens que rattaché à sa
  // demande ; côté applicatif, la suppression d'une demande ayant un
  // rendez-vous ACTIF (CONFIRMED) est bloquée explicitement avant même
  // d'atteindre la base (voir /api/admin/quote-requests/[id] DELETE) — cette
  // cascade ne joue donc que si l'admin a explicitement annulé le rendez-vous
  // au préalable, ou pour les statuts terminaux (CANCELLED/COMPLETED/NO_SHOW).
  appointment Appointment?

  // Timeline métier (voir ActivityEvent ci-dessous) — extensible, jamais de secret dedans.
  events ActivityEvent[]

  @@index([status, createdAt])
}

// Rendez-vous atelier — agenda entièrement interne, aucune dépendance externe
// (pas de Google/Apple Calendar). Voir src/lib/agenda/ pour toute la logique
// métier (moteur de disponibilités, services, emails, ICS).
model Appointment {
  id             String        @id @default(cuid())
  // Nullable depuis la Phase 4 (RDV manuels, ex: client au téléphone/comptoir
  // sans demande de devis) — @unique reste valide sur une colonne nullable en
  // Postgres (NULL n'est jamais considéré égal à un autre NULL), donc
  // plusieurs RDV manuels peuvent coexister sans conflit d'unicité.
  quoteRequestId String?       @unique
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  // Snapshot au moment de la planification — l'agenda reste lisible même si
  // la demande est modifiée/désynchronisée ensuite (même principe que les
  // caches Pennylane : jamais de recalcul implicite silencieux).
  customerName  String
  // Nullable depuis la Phase 4 : un RDV manuel peut n'avoir aucun email
  // (client passé au comptoir/téléphone) — voir sendAppointment*Email, tous
  // les envois sont conditionnés à sa présence, jamais une erreur bloquante.
  customerEmail String?
  customerPhone String
  vehicle       String // "Marque Modèle (Année)"

  // Champs snapshot RDV MANUEL uniquement (quoteRequestId null) — jamais
  // dupliqués depuis QuoteRequest pour un RDV lié à une demande : dans ce
  // cas motorisation/rearDiffuser/adresse/licensePlate continuent d'être lus
  // depuis QuoteRequest (voir src/lib/pennylane-v2/client-profile.ts),
  // exactement comme avant la Phase 4. licensePlate suit ce même principe
  // depuis la Phase C (2026-08-10) : QuoteRequest.licensePlate est la donnée
  // CANONIQUE pour un RDV lié — Appointment.licensePlate n'est jamais lu ni
  // affiché dans ce cas, uniquement pour un RDV manuel (voir
  // resolveAppointmentLicensePlate() dans src/lib/agenda/workshop-status.ts).
  customerAddress String?
  motorisation    String?
  licensePlate    String?
  rearDiffuser    String?
  vehicleNotes    String  @default("")

  // Résolution Pennylane optionnelle pour un RDV manuel (recherche par
  // email/téléphone, jamais de création, jamais bloquant — voir
  // findExistingPennylaneCustomerForManualAppointment). Toujours null pour
  // un RDV lié à une demande (le lien Pennylane vit sur QuoteRequest).
  pennylaneCustomerId   String?
  pennylaneCustomerType String? // "individual" | "company"

  startAt         DateTime
  endAt           DateTime
  durationMinutes Int

  // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  // PENDING n'est atteint par aucun flux actuel — réservé à une évolution
  // future (proposition de créneau avant accord client). La planification
  // admin crée toujours directement en CONFIRMED (décision produit validée).
  // Statuts propres au rendez-vous (réservation), jamais mélangés avec
  // QuoteRequest.status ni avec workshopStatus ci-dessous (progression physique).
  status String @default("PENDING")
  notes  String @default("")

  // Progression physique atelier (2026-08-10) — null tant que le véhicule
  // n'est pas arrivé, puis "VEHICULE_ARRIVE" | "EN_INTERVENTION" | "TERMINE"
  // | "RESTITUE". Volontairement ICI (pas sur QuoteRequest) : fonctionne pour
  // TOUT rendez-vous, y compris un RDV manuel sans demande liée. Quand
  // quoteRequestId n'est pas nul, chaque action atelier met aussi à jour
  // QuoteRequest.status en miroir à sens unique (voir
  // src/lib/agenda/workshop-status.ts) — jamais l'inverse, jamais de
  // synchronisation bidirectionnelle.
  workshopStatus String?

  // Notification client "véhicule prêt" — action explicite (jamais
  // automatique) déclenchée depuis le passage à TERMINE, voir
  // src/lib/agenda/workshop-actions.ts. Volontairement ICI (pas sur
  // QuoteRequest) : un RDV manuel n'a pas de QuoteRequest mais doit pouvoir
  // terminer son intervention normalement, avec ou sans notification (email
  // client facultatif sur un RDV manuel).
  //
  // (2026-08-10, correctif fiabilité) `vehicleReadyNotifiedAt` ne représente
  // QUE la date d'un envoi Resend RÉELLEMENT réussi — jamais posée avant ou
  // pendant la tentative. La protection anti-double-envoi/concurrence repose
  // sur `vehicleReadyNotificationInProgress` (verrou distinct, voir
  // canAttemptVehicleReadyNotification() dans workshop-status.ts et
  // attemptVehicleReadyNotification() dans workshop-actions.ts) : c'est ce
  // verrou, réservé par une UPDATE conditionnelle atomique, qui empêche deux
  // tentatives concurrentes d'envoyer deux emails — pas cette date. Confondre
  // les deux était précisément le défaut de la version précédente (un échec
  // Resend après réservation de cette date bloquait alors tout renvoi).
  vehicleReadyNotifiedAt DateTime?

  // Verrou de tentative d'envoi — true UNIQUEMENT pendant l'exécution d'un
  // essai (entre la réservation atomique et son issue, succès ou échec).
  // Toujours remis à false à la fin de l'essai, y compris en cas d'échec —
  // c'est ce qui permet un nouvel essai immédiat ("Réessayer l'envoi") sans
  // attendre. Le seuil de récupération (STALE_CLAIM_MS, workshop-status.ts)
  // ne sert qu'au cas résiduel d'un crash serveur en plein essai (verrou
  // resté à true sans jamais être libéré) — auto-guérison, sans intervention.
  vehicleReadyNotificationInProgress Boolean @default(false)

  // Horodatage du début du dernier essai (réussi ou non) — repère admin
  // ("dernière tentative le...") ET seuil de détection d'un verrou resté
  // bloqué (voir vehicleReadyNotificationInProgress ci-dessus).
  vehicleReadyNotificationLastAttemptAt DateTime?

  // Message d'erreur court du dernier essai en échec — jamais la réponse
  // brute Resend (voir sendVehicleReadyEmail()/attemptVehicleReadyNotification()).
  // Remis à null dès qu'un essai réussit (vehicleReadyNotifiedAt posée).
  vehicleReadyNotificationLastError String?

  // Photos avant/après intervention — métadonnées uniquement (même pattern que
  // QuoteRequest.photos), jamais l'image en base. Schéma posé par anticipation
  // (2026-08-10) mais NON fonctionnel tant que BLOB_READ_WRITE_TOKEN n'est pas
  // configuré (absent lors du dernier audit) — voir docs/MAINTENANCE.md.
  photosAvant Json @default("[]")
  photosApres Json @default("[]")

  confirmationSentAt DateTime?
  // Générique, superseded par les deux champs dédiés ci-dessous (rappels
  // 24h/1h, Phase 2 agenda) — conservé tel quel (aucune donnée existante),
  // jamais renseigné par le code actuel.
  reminderSentAt      DateTime?
  // Rappels 24h/1h avant le rendez-vous — champs prêts, AUCUN déclencheur
  // (cron) implémenté : voir src/lib/agenda/reminders.ts (calcul pur des
  // rappels dus) pour le détail de ce qui est prévu vs activé.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  cancelledAt        DateTime?
  cancelledBy        String? // "CUSTOMER" | "WORKSHOP"
  cancellationReason String? // saisi par le client sur la page publique, 500 caractères max — jamais par l'admin

  // Annulation client sécurisée — jamais le token brut en base, uniquement
  // son hash SHA-256 (voir src/lib/agenda/cancellation-token.ts). Régénéré à
  // chaque confirmation ET à chaque déplacement (l'ancien est invalidé).
  cancellationTokenHash      String?   @unique
  cancellationTokenExpiresAt DateTime? // = startAt : un lien n'a plus de sens après l'heure du rendez-vous
  cancellationRequestedAt    DateTime?
  cancellationEmailSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Timeline métier (voir ActivityEvent ci-dessous) — extensible, jamais de secret dedans.
  events ActivityEvent[]

  @@index([startAt])
  @@index([status])
}

// Timeline métier persistante — événements importants du parcours d'une
// demande/d'un rendez-vous (création, changement de statut, RDV, actions
// atelier, relances, avis...). Modèle générique et extensible par
// construction : `type` est une String libre (pas un enum Prisma), ajouter un
// nouveau type d'événement ne nécessite donc aucune migration. `metadata` ne
// doit JAMAIS contenir de secret (tokens, clés...) — uniquement des données
// d'affichage (ancien/nouveau statut, etc.). Voir src/lib/activity-events.ts.
model ActivityEvent {
  id             String        @id @default(cuid())
  quoteRequestId String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  type     String // ex. QUOTE_REQUEST_CREATED, QUOTE_STATUS_CHANGED, APPOINTMENT_CREATED, VEHICLE_ARRIVED...
  title    String // libellé français prêt à afficher
  metadata Json? // jamais de secret — uniquement des données d'affichage
  actor    String? // "admin" | "system" | "customer"

  createdAt DateTime @default(now())

  @@index([quoteRequestId, createdAt])
  @@index([appointmentId, createdAt])
}

// Paramètres de l'agenda atelier — ligne unique (singleton), éditable depuis
// /admin/settings § "Agenda atelier". Voir src/lib/agenda/settings.ts pour le
// repli sur des valeurs par défaut tant qu'aucune ligne n'existe (même
// pattern que SiteSettings ci-dessous).
model AgendaSettings {
  id String @id @default("singleton")

  // Horaires hebdomadaires — JSON :
  // { mon: { enabled, morningStart, morningEnd, afternoonStart, afternoonEnd }, tue: {...}, ... sun }
  // Le "trou" entre morningEnd et afternoonStart EST la pause déjeuner.
  // Valeurs par défaut posées par settings.ts (pas ici, pour rester lisible).
  weeklyHours Json @default("{}")

  defaultDurationMinutes Int @default(60)
  // Demi-journée/journée : valeurs fixes configurables (décision produit
  // validée) — pas dérivées des horaires réels du jour choisi.
  halfDayDurationMinutes Int @default(240)
  fullDayDurationMinutes Int @default(480)
  bufferMinutes          Int @default(15) // marge entre deux véhicules

  updatedAt DateTime @updatedAt
}

// Fermetures exceptionnelles de l'atelier (jours fériés, congés, formation,
// travaux...) — liste, pas un singleton. Représente une PLAGE de dates
// inclusive (startDate <= jour <= endDate bloque tous les créneaux de
// chaque jour concerné, quels que soient les horaires habituels) — un
// congé de plusieurs semaines est une seule ligne, jamais un enregistrement
// par jour. Anciennement une seule `date` (String @unique) : migration
// additive (2026-08) ayant conservé chaque fermeture existante comme une
// plage d'un seul jour (startDate = endDate = ancienne date).
model WorkshopClosure {
  id        String   @id @default(cuid())
  label     String   @default("") // ex. "Congés d'été", "Jour férié" — anciennement "reason"
  startDate String // "AAAA-MM-JJ", inclusif
  endDate   String // "AAAA-MM-JJ", inclusif, >= startDate
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

// Bloc atelier manuel (2026-08) — occupe un créneau SANS client rattaché
// (pause, réunion, congé, livraison, fermeture exceptionnelle ponctuelle,
// déplacement, maintenance...). Volontairement un modèle séparé plutôt que
// de rendre les champs client d'Appointment optionnels — évite une
// migration risquée sur un modèle déjà en production et garde la relation
// 1:1 QuoteRequest/Appointment intacte. Le moteur de disponibilités
// (src/lib/agenda/availability.ts) reste inchangé : il ne connaît que des
// intervalles [startAt, endAt) à éviter, que la donnée vienne d'un
// Appointment ou d'un AgendaBlock (fusionnés par appointments.ts avant
// l'appel au moteur).
model AgendaBlock {
  id       String   @id @default(cuid())
  startAt  DateTime
  endAt    DateTime
  // "pause" | "reunion" | "conge" | "livraison" | "fermeture" | "deplacement" | "maintenance" | "autre"
  category String
  label    String
  notes    String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}

// Paramètres globaux du site, éditables depuis /admin/settings.
// Ligne unique (id fixe "singleton") — voir src/lib/settings-repo.ts pour le
// fallback sur les valeurs codées en dur tant qu'aucune ligne n'existe.
model SiteSettings {
  id String @id @default("singleton")

  businessName        String  @default("PERF'EXHAUST")
  phone                String  @default("+33636523058")
  email                String  @default("contact@perfexhaust.fr")
  address              String  @default("30 Rue de Soufflenheim")
  postalCode           String  @default("67480")
  city                 String  @default("Rountzenheim-Auenheim")
  instagramUrl         String  @default("https://www.instagram.com/perfexhaust67/")
  tiktokUrl            String  @default("https://www.tiktok.com/@perfexhaust")
  googleReviewsUrl     String  @default("")
  shiftechUrl          String  @default("https://www.shiftech.eu")
  openingHours         String  @default("Lun–Ven : 8h–18h (sur rendez-vous)")
  legalForm            String  @default("")
  siret                String  @default("882 838 667 00021")
  publicationDirector  String  @default("")

  // Mode manuel Pennylane (plan gratuit, sans API) — voir src/lib/pennylane/mode.ts.
  // URL ouverte par le bouton "Ouvrir Pennylane + copier les infos" de
  // /admin/devis/[id] : idéalement un lien direct vers la création de devis
  // si Pennylane en expose un, sinon la page d'accueil de l'app.
  pennylaneManualUrl String @default("https://app.pennylane.com/")

  // Relances commerciales (2026-08-10) — voir src/lib/quote-followup.ts.
  // Désactivées par défaut : la file "Clients à relancer" (mode manuel,
  // /admin/devis) fonctionne indépendamment de ce réglage, qui ne gouverne que
  // l'éventuel déclenchement automatique (cron, non activé pour l'instant).
  followupDelay1Days        Int     @default(3)
  followupDelay2Days        Int     @default(7)
  followupAutomationEnabled Boolean @default(false)

  // Rappels de rendez-vous (2026-08-10) — voir src/lib/agenda/reminders.ts.
  // Ces réglages gouvernent l'automation-runner une fois branché ; le calcul
  // (dueReminders()) existe déjà et reste inchangé.
  reminder24hEnabled Boolean @default(false)
  reminder1hEnabled  Boolean @default(false)

  // Demande d'avis Google après restitution (2026-08-10) — voir
  // src/lib/email.ts. googleReviewsUrl (ci-dessus) reste la seule source de
  // vérité pour le lien ; ces deux champs ne pilotent que le délai/l'activation.
  reviewRequestEnabled    Boolean @default(false)
  reviewRequestDelayHours Int     @default(24)

  updatedAt DateTime @updatedAt
}

// Prestations affichées sur /services, gérées depuis /admin/services.
// Fallback statique : src/data/services.ts tant qu'aucune ligne n'existe.
model Service {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  shortDescription  String
  longDescription   String   @default("")
  icon              String   @default("wrench")
  status            String   @default("draft") // "draft" | "published"
  sortOrder         Int      @default(0)
  seoTitle          String?
  seoDescription    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

// Questions fréquentes affichées sur la home, gérées depuis /admin/faq.
// Fallback statique : liste codée dans src/lib/faq-repo.ts tant qu'aucune
// ligne n'existe. Le schema.org FAQPage est généré depuis les mêmes données.
model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  status    String   @default("draft") // "draft" | "published"
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

// Un abonnement Web Push par appareil admin (jamais partagé entre appareils —
// un même admin connecté sur iPhone + Mac + PC a 3 lignes distinctes, voir
// src/lib/push/sendPushNotification.ts § sendPushToAllAdmins). `endpoint` est
// l'identifiant stable fourni par le navigateur/service push (FCM, Mozilla
// Push, etc.) : unique par définition, jamais réutilisé par deux appareils.
// `p256dh`/`auth` sont les clés de chiffrement du payload (jamais des
// secrets serveur — elles ne servent à rien sans la clé VAPID privée, qui
// elle ne quitte jamais le serveur, voir PUSH_VAPID_PRIVATE_KEY).
model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String
  auth     String

  // Contexte informatif seulement (aide au libellé "Chrome sur MacBook" dans
  // /admin/settings) — jamais utilisé pour une décision de sécurité.
  userAgent   String?
  deviceLabel String?

  // Désactivé plutôt que supprimé sur une erreur d'envoi non définitive
  // (voir cleanupExpiredSubscription) — seule une 404/410 du provider (lien
  // mort confirmé) entraîne une suppression immédiate.
  enabled Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  lastError  String?

  @@index([enabled])
}
