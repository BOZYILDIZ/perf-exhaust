// Schéma Prisma — PERF'EXHAUST
// Base : PostgreSQL (Neon / Vercel Postgres en production, instance locale en dev).
// Voir docs/MAINTENANCE.md § "Panel admin & base de données".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    String   @default("draft") // "draft" | "published"

  // Informations principales
  vehicule    String
  marque      String
  modele      String
  annee       String
  prestation  String
  categorie   String?
  tags        Json     @default("[]") // string[]
  sonoriteTag String
  filterTags  Json     @default("[]") // string[] — pilote les filtres de la galerie

  // Contenu
  description             String
  descriptionComplete     String
  objectifsClient         String  @default("")
  modificationsRealisees  String  @default("")
  materiaux               String  @default("")
  resultatSonore          String  @default("")
  dureeProjet             String?
  difficulte              String?
  ctaCustom               String?

  // Médias
  imagePrincipale String?
  imageAlt        String?
  galerie         Json    @default("[]") // { src, alt, type: "avant"|"apres"|"detail" }[]
  videoUrl        String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Divers
  featured  Boolean @default(false)
  date      String  @default("") // AAAA-MM-JJ (affichage + sitemap)
  sortOrder Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, sortOrder])
}

// Demandes de devis reçues via /rendez-vous — persistées en plus de l'email
// (mini-CRM atelier). Le formulaire continue de fonctionner même si l'écriture
// en base échoue (voir src/app/api/rendez-vous/route.ts).
model QuoteRequest {
  id  String @id @default(cuid())

  nom          String
  prenom       String
  email        String
  telephone    String

  // Adresse de facturation — collectée depuis /rendez-vous sur une branche
  // distincte (feat/pennylane-billing-address, non mergée à ce jour). Champ
  // conservé ici pour rester fidèle à l'état réel de la base partagée (même
  // principe que `photos` ci-dessous) — hors périmètre de la mission Agenda,
  // jamais utilisé par le code de cette branche.
  billingAddress    String?
  billingPostalCode String?
  billingCity       String?

  marque       String
  modele       String
  annee        String
  motorisation String?
  typeProjet   String
  sonorite     String
  rearDiffuser String  @default("je_ne_sais_pas") // "oui" | "non" | "je_ne_sais_pas"
  message      String

  // Photos du véhicule (upload public, hors périmètre de la mission Pennylane
  // — feature en pause, migration déjà appliquée en base) — champ conservé
  // ici pour rester fidèle à l'état réel de la base, jamais utilisé par
  // l'intégration Pennylane (les images ne sont jamais envoyées à Pennylane).
  photos Json @default("[]")

  status String @default("new") // "new" | "contacted" | "in_progress" | "completed" | "archived"
  notes  String @default("") // notes internes atelier, jamais exposées publiquement

  // Intégration Pennylane — voir src/lib/pennylane/. Deux modes cohabitent
  // (PENNYLANE_MODE, voir src/lib/pennylane/mode.ts) :
  //  - "api"    : brouillon créé automatiquement par POST /rendez-vous
  //               (nécessite un abonnement Pennylane avec accès API) ;
  //               statut reflété par pennylaneSyncStatus/*Error/*SyncedAt.
  //  - "manual" : plan gratuit Pennylane (pas d'API) — l'admin copie les
  //               informations depuis /admin/devis/[id] et crée le devis à
  //               la main dans Pennylane, puis renseigne pennylaneManualStatus
  //               + pennylaneQuoteNumber/Url manuellement.
  // Dans les deux cas, Pennylane reste la source unique pour les devis et
  // factures — le panel PERF'EXHAUST ne construit jamais de devis local.
  pennylaneCustomerId  String?
  pennylaneQuoteId     String?
  pennylaneQuoteNumber String?
  pennylaneQuoteUrl    String?
  pennylaneSyncStatus  String?   @default("not_configured") // mode "api" : "not_configured" | "pending" | "draft_created" | "failed"
  pennylaneSyncError   String?
  pennylaneSyncedAt    DateTime?
  pennylaneManualStatus String?  // mode "manual" : "a_creer" | "devis_cree" | "devis_envoye" | "devis_accepte" | "devis_refuse" | "facture_creee" | "paye"

  // Intégration Pennylane API v2 (src/lib/pennylane-v2/) — synchronisation
  // CLIENT automatique à la réception de chaque demande, indépendante des
  // champs "quote" ci-dessus (qui suivent la création manuelle/automatique
  // d'un DEVIS dans l'ancien flux). pennylaneCustomerId (ci-dessus) reste
  // l'identifiant client Pennylane commun aux deux intégrations — jamais
  // dupliqué, réutilisé tel quel. Statuts : "PENDING" | "SYNCED" | "FAILED"
  // | "AMBIGUOUS". Voir docs/MAINTENANCE.md § "Intégration Pennylane API v2".
  pennylaneCustomerSyncStatus  String?   @default("PENDING")
  pennylaneCustomerSyncError   String?
  pennylaneCustomerSyncedAt    DateTime? // dernière synchronisation RÉUSSIE
  pennylaneCustomerLastSyncAt  DateTime? // dernière TENTATIVE (réussie ou non)
  pennylaneCustomerType        String?   // "individual" | "company" une fois synchronisé
  // Candidats ambigus détectés lors de la recherche (statut AMBIGUOUS) —
  // snapshot au moment de la détection : [{ id, name, email, phone }].
  // L'admin choisit manuellement le bon client depuis le panel.
  pennylaneAmbiguousCandidates Json?

  // Cache des devis/factures Pennylane du client — évite un appel API à
  // chaque rendu de la fiche admin. Rafraîchi automatiquement si expiré à
  // l'ouverture, ou à la demande via le bouton "Actualiser" (voir
  // src/lib/pennylane-v2/cache.ts pour le délai d'expiration).
  pennylaneQuotesCache        Json?
  pennylaneInvoicesCache      Json?
  pennylaneFinancialsSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Agenda atelier (2026-08) — une demande a au maximum un rendez-vous.
  // Suppression en cascade : un rendez-vous n'a de sens que rattaché à sa
  // demande ; côté applicatif, la suppression d'une demande ayant un
  // rendez-vous ACTIF (CONFIRMED) est bloquée explicitement avant même
  // d'atteindre la base (voir /api/admin/quote-requests/[id] DELETE) — cette
  // cascade ne joue donc que si l'admin a explicitement annulé le rendez-vous
  // au préalable, ou pour les statuts terminaux (CANCELLED/COMPLETED/NO_SHOW).
  appointment Appointment?

  @@index([status, createdAt])
}

// Rendez-vous atelier — agenda entièrement interne, aucune dépendance externe
// (pas de Google/Apple Calendar). Voir src/lib/agenda/ pour toute la logique
// métier (moteur de disponibilités, services, emails, ICS).
model Appointment {
  id             String       @id @default(cuid())
  quoteRequestId String       @unique
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  // Snapshot au moment de la planification — l'agenda reste lisible même si
  // la demande est modifiée/désynchronisée ensuite (même principe que les
  // caches Pennylane : jamais de recalcul implicite silencieux).
  customerName  String
  customerEmail String
  customerPhone String
  vehicle       String // "Marque Modèle (Année)"

  startAt         DateTime
  endAt           DateTime
  durationMinutes Int

  // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  // PENDING n'est atteint par aucun flux actuel — réservé à une évolution
  // future (proposition de créneau avant accord client). La planification
  // admin crée toujours directement en CONFIRMED (décision produit validée).
  // Statuts propres au rendez-vous, jamais mélangés avec QuoteRequest.status.
  status String @default("PENDING")
  notes  String @default("")

  confirmationSentAt DateTime?
  // Générique, superseded par les deux champs dédiés ci-dessous (rappels
  // 24h/1h, Phase 2 agenda) — conservé tel quel (aucune donnée existante),
  // jamais renseigné par le code actuel.
  reminderSentAt      DateTime?
  // Rappels 24h/1h avant le rendez-vous — champs prêts, AUCUN déclencheur
  // (cron) implémenté : voir src/lib/agenda/reminders.ts (calcul pur des
  // rappels dus) pour le détail de ce qui est prévu vs activé.
  reminder24hSentAt DateTime?
  reminder1hSentAt  DateTime?
  cancelledAt        DateTime?
  cancelledBy        String? // "CUSTOMER" | "WORKSHOP"
  cancellationReason String? // saisi par le client sur la page publique, 500 caractères max — jamais par l'admin

  // Annulation client sécurisée — jamais le token brut en base, uniquement
  // son hash SHA-256 (voir src/lib/agenda/cancellation-token.ts). Régénéré à
  // chaque confirmation ET à chaque déplacement (l'ancien est invalidé).
  cancellationTokenHash      String?   @unique
  cancellationTokenExpiresAt DateTime? // = startAt : un lien n'a plus de sens après l'heure du rendez-vous
  cancellationRequestedAt    DateTime?
  cancellationEmailSentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([status])
}

// Paramètres de l'agenda atelier — ligne unique (singleton), éditable depuis
// /admin/settings § "Agenda atelier". Voir src/lib/agenda/settings.ts pour le
// repli sur des valeurs par défaut tant qu'aucune ligne n'existe (même
// pattern que SiteSettings ci-dessous).
model AgendaSettings {
  id String @id @default("singleton")

  // Horaires hebdomadaires — JSON :
  // { mon: { enabled, morningStart, morningEnd, afternoonStart, afternoonEnd }, tue: {...}, ... sun }
  // Le "trou" entre morningEnd et afternoonStart EST la pause déjeuner.
  // Valeurs par défaut posées par settings.ts (pas ici, pour rester lisible).
  weeklyHours Json @default("{}")

  defaultDurationMinutes Int @default(60)
  // Demi-journée/journée : valeurs fixes configurables (décision produit
  // validée) — pas dérivées des horaires réels du jour choisi.
  halfDayDurationMinutes Int @default(240)
  fullDayDurationMinutes Int @default(480)
  bufferMinutes          Int @default(15) // marge entre deux véhicules

  updatedAt DateTime @updatedAt
}

// Fermetures exceptionnelles de l'atelier (jours fériés, congés...) — liste,
// pas un singleton. Une date fermée bloque tous les créneaux ce jour-là,
// quels que soient les horaires habituels.
model WorkshopClosure {
  id        String   @id @default(cuid())
  date      String   @unique // "AAAA-MM-JJ"
  reason    String   @default("")
  createdAt DateTime @default(now())
}

// Bloc atelier manuel (2026-08) — occupe un créneau SANS client rattaché
// (pause, réunion, congé, livraison, fermeture exceptionnelle ponctuelle,
// déplacement, maintenance...). Volontairement un modèle séparé plutôt que
// de rendre les champs client d'Appointment optionnels — évite une
// migration risquée sur un modèle déjà en production et garde la relation
// 1:1 QuoteRequest/Appointment intacte. Le moteur de disponibilités
// (src/lib/agenda/availability.ts) reste inchangé : il ne connaît que des
// intervalles [startAt, endAt) à éviter, que la donnée vienne d'un
// Appointment ou d'un AgendaBlock (fusionnés par appointments.ts avant
// l'appel au moteur).
model AgendaBlock {
  id       String   @id @default(cuid())
  startAt  DateTime
  endAt    DateTime
  // "pause" | "reunion" | "conge" | "livraison" | "fermeture" | "deplacement" | "maintenance" | "autre"
  category String
  label    String
  notes    String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}

// Paramètres globaux du site, éditables depuis /admin/settings.
// Ligne unique (id fixe "singleton") — voir src/lib/settings-repo.ts pour le
// fallback sur les valeurs codées en dur tant qu'aucune ligne n'existe.
model SiteSettings {
  id String @id @default("singleton")

  businessName        String  @default("PERF'EXHAUST")
  phone                String  @default("+33636523058")
  email                String  @default("contact@perfexhaust.fr")
  address              String  @default("30 Rue de Soufflenheim")
  postalCode           String  @default("67480")
  city                 String  @default("Rountzenheim-Auenheim")
  instagramUrl         String  @default("https://www.instagram.com/perfexhaust67/")
  tiktokUrl            String  @default("https://www.tiktok.com/@perfexhaust")
  googleReviewsUrl     String  @default("")
  shiftechUrl          String  @default("https://www.shiftech.eu")
  openingHours         String  @default("Lun–Ven : 8h–18h (sur rendez-vous)")
  legalForm            String  @default("")
  siret                String  @default("882 838 667 00021")
  publicationDirector  String  @default("")

  // Mode manuel Pennylane (plan gratuit, sans API) — voir src/lib/pennylane/mode.ts.
  // URL ouverte par le bouton "Ouvrir Pennylane + copier les infos" de
  // /admin/devis/[id] : idéalement un lien direct vers la création de devis
  // si Pennylane en expose un, sinon la page d'accueil de l'app.
  pennylaneManualUrl String @default("https://app.pennylane.com/")

  updatedAt DateTime @updatedAt
}

// Prestations affichées sur /services, gérées depuis /admin/services.
// Fallback statique : src/data/services.ts tant qu'aucune ligne n'existe.
model Service {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  shortDescription  String
  longDescription   String   @default("")
  icon              String   @default("wrench")
  status            String   @default("draft") // "draft" | "published"
  sortOrder         Int      @default(0)
  seoTitle          String?
  seoDescription    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

// Questions fréquentes affichées sur la home, gérées depuis /admin/faq.
// Fallback statique : liste codée dans src/lib/faq-repo.ts tant qu'aucune
// ligne n'existe. Le schema.org FAQPage est généré depuis les mêmes données.
model FAQItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  status    String   @default("draft") // "draft" | "published"
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}
